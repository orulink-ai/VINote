# ============ Service ============
HOST=0.0.0.0
PORT=8900
CORS_ALLOW_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
BACKEND_PORT=8900
FRONTEND_PORT=3100
POSTGRES_PORT=54322

# ============ App Auth ============
APP_JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_SECONDS=604800
AUTH_COOKIE_NAME=vinote_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
SHARE_BASE_URL=

# ============ Database ============
POSTGRES_DB=vinote
POSTGRES_USER=vinote
POSTGRES_PASSWORD=change-me-to-a-long-random-db-password
DATABASE_URL=postgresql+psycopg://vinote:change-me-to-a-long-random-db-password@127.0.0.1:54322/vinote

# ============ LLM ============
# Required Langfuse project credentials; tracing is always enabled in the product.
# Both desktop channels embed these project credentials in backend resources.
LANGFUSE_BASE_URL=http://192.168.1.118:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=0.5.1

LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai-compatible

# ============ Model Profile Security ============
MODEL_PROFILE_ENCRYPTION_KEY=replace-with-a-long-random-secret
AZURE_OPENAI_API_VERSION=2024-10-21

# ============ Transcriber ============
TRANSCRIBER_TYPE=groq
GROQ_API_KEY=gsk_your-groq-api-key

# ============ Storage ============
DATA_DIR=data
OUTPUT_DIR=output

# ============ Media Download ============
# Pace anonymous YouTube requests to reduce rate-limit and bot challenges.
YTDLP_REQUEST_SLEEP_SECONDS=1
YTDLP_DOWNLOAD_SLEEP_SECONDS=3
YTDLP_MAX_DOWNLOAD_SLEEP_SECONDS=6

# ============ Frontend Runtime ============
VITE_API_BASE_URL=
VITE_DOCS_BASE_URL=
DOCS_PORT=3101
# Cloud model service (deployment administrator only; never exposed to browsers).
VILAB_SERVER_URL=
VILAB_API_KEY=
# When configured, cloud calls use each VINote user's Supabase token, not VILAB_API_KEY.
VINOTE_SUPABASE_URL=
VINOTE_SUPABASE_PUBLISHABLE_KEY=
