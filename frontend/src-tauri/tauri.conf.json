{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VINote",
  "version": "0.5.1",
  "identifier": "app.vinote.desktop",
  "build": {
    "beforeDevCommand": "node ../scripts/ensure-web-dev.mjs",
    "beforeBuildCommand": "npm run web:build:tauri",
    "devUrl": "http://127.0.0.1:3100",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "VINote",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
