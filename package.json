{
  "name": "vinote",
  "private": true,
  "version": "0.5.1",
  "description": "VINote workspace command shortcuts",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "node scripts/dev-desktop.mjs",
    "api:dev": "node scripts/dev-api.mjs",
    "client:dev": "node scripts/dev-desktop.mjs",
    "web:dev": "yarn --cwd frontend web:dev",
    "build": "yarn --cwd frontend build",
    "preview": "yarn --cwd frontend preview",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:build:release": "node scripts/build-desktop.mjs --channel release",
    "desktop:build:test": "node scripts/build-desktop.mjs --channel test",
    "desktop:check": "node --test scripts/desktop-build-profile.test.mjs",
    "docs:dev": "yarn --cwd docs docs:dev",
    "docs:build": "yarn --cwd docs docs:build"
  }
}
